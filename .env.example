# RelayTag Environment Configuration Template
# Copy this file to .env for local development. Never commit your real .env file to GitHub.

# Server-only secret key used to derive AES-256-GCM vault keys, HMAC session signatures, and Telegram webhook tokens
RELAYTAG_VAULT_SECRET=replace-with-32-byte-random-secret

# Required in production (>= 32 chars); the server refuses to start without it
# Number of reverse proxies in front of the server that append to X-Forwarded-For.
# Defaults to 1 in production and 0 elsewhere. Verify against the live URL: spoofed headers must not dodge 429s.
TRUST_PROXY_HOPS=1

# Optional public base URL included in Telegram scan notifications
APP_URL=http://localhost:3000
